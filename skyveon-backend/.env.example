# changes needed, Neon speaks the same Postgres wire protocol.
DATABASE_URL="postgresql://neondb_owner:npg_a4ti9fxYGoRq@ep-old-field-aigsb4pa-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require"
# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"
# Used to sign short-lived, single-use links (password setup, reset, file URLs)
SIGNED_LINK_SECRET="change-me-signed-link-secret"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV="development"
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- File storage -----------------------------------------------------------
# "local" writes to the /uploads folder on disk. Switch to "b2" once your
# Backblaze B2 bucket is set up.
STORAGE_DRIVER="local"
UPLOADS_DIR="uploads"
MAX_UPLOAD_MB=200

# Backblaze B2 (only needed once STORAGE_DRIVER="b2")
# - B2_ENDPOINT / B2_REGION: B2 dashboard -> Buckets -> your bucket -> Endpoint
#   (looks like https://s3.us-west-004.backblazeb2.com — region is the
#   "us-west-004" part)
# - B2_KEY_ID / B2_APPLICATION_KEY: B2 dashboard -> App Keys -> Add a New
#   Application Key (scope it to just this bucket)
# - B2_BUCKET: the bucket name itself
B2_ENDPOINT=""
B2_REGION="us-west-004"
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET=""
B2_PUBLIC_URL=""

# --- Jobs (BullMQ + Redis) ---------------------------------------------------
# Optional. Leave blank and email sending / file conversion just run inline
# (no retries, but the app works with zero extra infra). Set this to a real
# Redis URL (e.g. from Upstash's free tier, or a self-hosted instance) to
# get retries, backoff, and background processing for real.
REDIS_URL=""

# --- Email ------------------------------------------------------------------
# Leave SMTP_HOST blank in local dev — emails will be logged to the console
# instead of sent. Point this at SES or SendGrid's SMTP endpoint in prod;
# both work as a drop-in here, no code changes required.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Skyveon Learning Hub <hr@skyveon.ai>"

# --- File conversion ----------------------------------------------------
# Path to the LibreOffice CLI binary used for Office -> PDF conversion.
# Leave as "soffice" if it's on PATH (see README for install notes).
LIBREOFFICE_BIN="soffice"

# Path to the ffmpeg binary, used to burn a watermark into video lessons
# the first time each employee views them (cached after that — see
# src/lib/videoWatermark.ts). Leave as "ffmpeg" if it's on PATH.
FFMPEG_BIN="ffmpeg"